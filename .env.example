# API & Backend (Laravel)
API_PORT=8000
APP_NAME=Nimbus
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

# PostgreSQL (Docker & Laravel)
POSTGRES_DB=nimbus_app
POSTGRES_USER=nimbus_adm
POSTGRES_PASSWORD=secret
POSTGRES_PORT=5432
POSTGRES_URL=postgresql://nimbus_adm:secret@postgre:5432/nimbus_app

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google Cloud Platform (GCS & BigQuery)
GCP_PROJECT_ID=seu_projeto_gcp_aqui
GOOGLE_APPLICATION_CREDENTIALS=./gcp-sa-key.json


# Orquestrador (Prefect)
PREFECT_API_URL=http://prefect-server:4200/api

# APIs Meteorológicas & Ingestão
APAC_BASE_URL=http://old.apac.pe.gov.br/meteorologia/monitoramento-pluvio.php
INMET_TOKEN=
TOMORROW_IO_API_KEY=sua_key_aqui