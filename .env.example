# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=8000

# ─── INMET ────────────────────────────────────────────────────────────────────
INMET_TOKEN=seu_token_aqui

# ─── Mapbox ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_MAPBOX_TOKEN=seu_token_aqui

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql://user:password@localhost:5432/rmr

# ─── MinIO (Object Storage local — Docker Compose) ────────────────────────────
# Console Web: http://localhost:9001
# S3 API:      http://localhost:9000  |  Dentro do Docker: http://minio:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=minio_secret_123
MINIO_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=rmr_access_key
AWS_SECRET_ACCESS_KEY=rmr_secret_key

# ─── APIs Meteorológicas ──────────────────────────────────────────────────────
# Open-Meteo Weather + Marine: sem chave necessária (open source)
# Tomorrow.io Nowcasting: criar em https://app.tomorrow.io/
TOMORROW_IO_API_KEY=sua_key_aqui