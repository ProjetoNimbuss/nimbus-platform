config {
  type: "incremental",
  schema: "nimbus_silver_prod",
  tags: ["silver", "open_meteo", "previsao"],
  uniqueKey: ["cidade", "data_extracao", "data_previsao"],
  bigquery: {
    partitionBy: "data_extracao",
    clusterBy: ["cidade"]
  },
  description: "Resumos diários previstos para 7 dias (temperaturas mín/máx, total de chuva e sol)."
}

WITH bronze_limpa AS (
  SELECT
    SAFE_CAST(data_extracao AS DATE) AS data_extracao,
    SAFE_CAST(time AS DATE) AS data_previsao,
    UPPER(TRIM(cidade)) AS cidade,
    UPPER(TRIM(uf)) AS uf,
    SAFE_CAST(latitude AS FLOAT64) AS latitude,
    SAFE_CAST(longitude AS FLOAT64) AS longitude,
    COALESCE(SAFE_CAST(temperature_2m_max_ecmwf_ifs04 AS FLOAT64), SAFE_CAST(temperature_2m_max_gfs_seamless AS FLOAT64)) AS temperatura_max_c,
    COALESCE(SAFE_CAST(temperature_2m_min_ecmwf_ifs04 AS FLOAT64), SAFE_CAST(temperature_2m_min_gfs_seamless AS FLOAT64)) AS temperatura_min_c,
    COALESCE(SAFE_CAST(apparent_temperature_max_ecmwf_ifs04 AS FLOAT64), SAFE_CAST(apparent_temperature_max_gfs_seamless AS FLOAT64)) AS sensacao_max_c,
    COALESCE(SAFE_CAST(apparent_temperature_min_ecmwf_ifs04 AS FLOAT64), SAFE_CAST(apparent_temperature_min_gfs_seamless AS FLOAT64)) AS sensacao_min_c,
    COALESCE(SAFE_CAST(precipitation_sum_ecmwf_ifs04 AS FLOAT64), SAFE_CAST(precipitation_sum_gfs_seamless AS FLOAT64)) AS precipitacao_total_mm,
    COALESCE(SAFE_CAST(precipitation_probability_max_ecmwf_ifs04 AS INT64), SAFE_CAST(precipitation_probability_max_gfs_seamless AS INT64)) AS probabilidade_chuva_max_pct,
    COALESCE(SAFE_CAST(wind_speed_10m_max_ecmwf_ifs04 AS FLOAT64), SAFE_CAST(wind_speed_10m_max_gfs_seamless AS FLOAT64)) AS vento_max_kmh,
    COALESCE(SAFE_CAST(weather_code_ecmwf_ifs04 AS INT64), SAFE_CAST(weather_code_gfs_seamless AS INT64)) AS condicao_tempo_codigo,
    COALESCE(SAFE_CAST(sunrise_ecmwf_ifs04 AS TIMESTAMP), SAFE_CAST(sunrise_gfs_seamless AS TIMESTAMP)) AS nascer_do_sol,
    COALESCE(SAFE_CAST(sunset_ecmwf_ifs04 AS TIMESTAMP), SAFE_CAST(sunset_gfs_seamless AS TIMESTAMP)) AS por_do_sol
  FROM ${ref("open_meteo_weather_daily")}
  WHERE time IS NOT NULL 
    AND cidade IS NOT NULL
)

SELECT * FROM bronze_limpa
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY cidade, data_extracao, data_previsao 
  ORDER BY data_extracao DESC
) = 1
