config {
  type: "incremental",
  schema: "nimbus_silver_prod",
  tags: ["silver", "open_meteo", "previsao"],
  uniqueKey: ["cidade", "data_extracao", "data_previsao"],
  bigquery: {
    partitionBy: "data_extracao",
    clusterBy: ["cidade"]
  },
  description: "Resumos diários previstos para 7 dias (temperaturas mín/máx, total de chuva e sol)."
}

WITH bronze_limpa AS (
  SELECT
    SAFE_CAST(data_extracao AS DATE) AS data_extracao,
    SAFE_CAST(time AS DATE) AS data_previsao,
    UPPER(TRIM(cidade)) AS cidade,
    UPPER(TRIM(uf)) AS uf,
    SAFE_CAST(latitude AS FLOAT64) AS latitude,
    SAFE_CAST(longitude AS FLOAT64) AS longitude,
    SAFE_CAST(temperature_2m_max AS FLOAT64) AS temperatura_max_c,
    SAFE_CAST(temperature_2m_min AS FLOAT64) AS temperatura_min_c,
    SAFE_CAST(apparent_temperature_max AS FLOAT64) AS sensacao_max_c,
    SAFE_CAST(apparent_temperature_min AS FLOAT64) AS sensacao_min_c,
    SAFE_CAST(precipitation_sum AS FLOAT64) AS precipitacao_total_mm,
    SAFE_CAST(precipitation_probability_max AS INT64) AS probabilidade_chuva_max_pct,
    SAFE_CAST(wind_speed_10m_max AS FLOAT64) AS vento_max_kmh,
    SAFE_CAST(weather_code AS INT64) AS condicao_tempo_codigo,
    SAFE_CAST(sunrise AS TIMESTAMP) AS nascer_do_sol,
    SAFE_CAST(sunset AS TIMESTAMP) AS por_do_sol
  FROM ${ref("open_meteo_weather_daily")}
  WHERE time IS NOT NULL 
    AND cidade IS NOT NULL
)

SELECT * FROM bronze_limpa
QUALIFY ROW_NUMBER() OVER (
  PARTITION BY cidade, data_extracao, data_previsao 
  ORDER BY data_extracao DESC
) = 1
